generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutSessions WorkoutSession[]
  programs Program[]
}

model Program {
  id              Int              @id @default(autoincrement())
  name            String
  isActive        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  type            ProgramType
  days            ProgramDay[]
  workoutSessions WorkoutSession[]

  user User @relation(fields: [userId], references: [id])
  userId Int
}

model ProgramDay {
  id              Int              @id @default(autoincrement())
  name            String
  order           Int
  programId       Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  exercises       DayExercise[]
  program         Program          @relation(fields: [programId], references: [id])
  workoutSessions WorkoutSession[]

  @@unique([programId, order])
}

model Exercise {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  exercises DayExercise[]
}

model DayExercise {
  id           Int          @id @default(autoincrement())
  programDayId Int
  exerciseId   Int
  order        Int
  targetSets   Int
  minReps      Int
  maxReps      Int
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])
  programDay   ProgramDay   @relation(fields: [programDayId], references: [id])
  workoutSets  WorkoutSet[]

  @@unique([programDayId, order])
}

enum ProgramType {
  AB
  PPL
  FULL_BODY
  CUSTOM
}

model WorkoutSession {
  id           Int        @id @default(autoincrement())
  program      Program    @relation(fields: [programId], references: [id])
  programId    Int
  programDay   ProgramDay @relation(fields: [programDayId], references: [id])
  programDayId Int

  user User @relation(fields: [userId], references: [id])
  userId Int

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  sets WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
}

model WorkoutSet {
  id        Int            @id @default(autoincrement())
  session   WorkoutSession @relation(fields: [sessionId], references: [id])
  sessionId Int

  dayExercise   DayExercise @relation(fields: [dayExerciseId], references: [id])
  dayExerciseId Int

  setNumber Int
  reps      Int
  weight    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, dayExerciseId, setNumber])
}
